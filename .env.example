# PostgreSQL connection (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://user:pass@localhost:5432/drukview
# Bearer secret protecting /api/cron/* (Vercel sends it automatically as "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=change-me
# Optional: override ADB's IATI activity file location
ADB_IATI_URL=
# Public site URL (for sitemap/share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Repo used for the "report a problem" links
NEXT_PUBLIC_GITHUB_REPO=Youngyang07/DrukView
