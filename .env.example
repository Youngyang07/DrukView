# PostgreSQL connection (Neon, Supabase, Vercel Postgres, or local)
DATABASE_URL=postgres://user:pass@localhost:5432/drukview
# Optional. Jobs run without it (rate-limited); a request with "Authorization: Bearer $CRON_SECRET" skips the rate limit.
CRON_SECRET=
# Optional. Where to post a notice when a source has not refreshed successfully for three days: any incoming
# webhook URL (Slack, Google Chat, Discord, ntfy). Left empty, the alert is still visible on the Data sources
# page and as a 503 from /api/health — point an uptime monitor at that, since it works even if cron is dead.
ALERT_WEBHOOK_URL=
# Optional. Hours without a successful refresh before a source counts as overdue (default 72 = three daily runs).
STALE_ALERT_HOURS=

# Optional: override ADB's IATI activity file location
ADB_IATI_URL=
# Optional source overrides, for testing a collector against a local copy. Leave empty in production:
# a wrong value here means a collector reads the wrong place (published citations stay pinned to the real portals).
EGP_BASE=
PARLIAMENT_API=
KUENSEL_FEED=
BHUTANESE_FEED=
# Public site URL (for sitemap/share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Repo used for the "report a problem" links
NEXT_PUBLIC_GITHUB_REPO=Youngyang07/DrukView
